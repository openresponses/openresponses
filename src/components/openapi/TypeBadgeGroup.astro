---
import type { ParameterRow } from "../../lib/openapi/referenceIndex";
type Props = { row: ParameterRow };
const { row } = Astro.props as Props;
---

<div class="parameter-type">
  {
    row.typeLinkId && !row.isUnion && !row.literalValue ? (
      <a href={`#${row.typeLinkId}`}>
        <code>{row.typeSummary}</code>
      </a>
    ) : (
      <code>{row.typeSummary}</code>
    )
  }
</div>
