---
import type {
  ParameterUnionVariant,
  UnionVariantLink,
} from "../../lib/openapi/referenceIndex";
type Props = { variants: (ParameterUnionVariant | UnionVariantLink)[] };
const { variants } = Astro.props as Props;
const label = (variant: ParameterUnionVariant | UnionVariantLink) =>
  variant.label + (variant.array ? "[]" : "");
---

<ul class="type-variants">
  {
    variants.map((variant) => (
      <li>
        {variant.sectionId ? (
          <a href={`#${variant.sectionId}`}>
            <code>{label(variant)}</code>
          </a>
        ) : (
          <code>{label(variant)}</code>
        )}
        {variant.groupVariants?.length > 0 && (
          <ul>
            {variant.groupVariants.map((group) => (
              <li>
                {group.sectionId ? (
                  <a href={`#${group.sectionId}`}>
                    <code>{label(group)}</code>
                  </a>
                ) : (
                  <code>{label(group)}</code>
                )}
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>
