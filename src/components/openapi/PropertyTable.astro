---
import EnumValues from "./EnumValues.astro";
import UnionVariantBadges from "./UnionVariantBadges.astro";
import AddedIn from "../AddedIn.astro";
import type { InlineRow } from "../../lib/openapi/referenceIndex";
import { parseInlineMarkdown } from "../../lib/markdown";

type Props = { rows: InlineRow[] };
const { rows } = Astro.props as Props;
---

<div class="parameter-list">
  {
    rows.map((row) => (
      <div class="parameter-row">
        <div class="parameter-meta">
          <div class="parameter-name">
            <>
              <code>{row.name}</code>
              <span
                class:list={[
                  "parameter-presence",
                  { "is-required": row.required },
                ]}
              >
                {row.required ? "required" : "optional"}
              </span>
            </>
          </div>
          <div class="parameter-type">
            <code>{row.typeSummary}</code>
          </div>
          {row.addedIn && <AddedIn version={row.addedIn} compact />}
        </div>
        <div class="parameter-description">
          {row.description && (
            <div set:html={parseInlineMarkdown(row.description)} />
          )}
          {row.unionVariants.some(
            (variant) => variant.sectionId || variant.groupVariants?.length,
          ) && (
            <details class="field-details">
              <summary>Accepted types</summary>
              <UnionVariantBadges variants={row.unionVariants} />
            </details>
          )}
          {!row.literalValue && row.enumValues.length > 0 && (
            <details class="field-details">
              <summary>Allowed values</summary>
              <EnumValues
                values={row.enumValues}
                descriptions={row.enumDescriptions}
              />
            </details>
          )}
        </div>
      </div>
    ))
  }
</div>
