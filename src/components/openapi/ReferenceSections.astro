---
import AddedIn from "../AddedIn.astro";
import EnumValues from "./EnumValues.astro";
import PropertyTable from "./PropertyTable.astro";
import UnionVariantBadges from "./UnionVariantBadges.astro";
import { buildReferenceSections } from "../../lib/openapi/referenceIndex";
import type { OpenApiDocument } from "../../lib/openapi/types";
import { parseInlineMarkdown } from "../../lib/markdown";

type Props = { apiSpec: OpenApiDocument; schemaNames: string[] };
const { apiSpec, schemaNames } = Astro.props as Props;
const schemas = schemaNames
  .filter((name) => apiSpec.components?.schemas?.[name])
  .map((name) => ({ $ref: `#/components/schemas/${name}` }));
const sections = buildReferenceSections(apiSpec, schemas);
---

{
  sections.enums.length > 0 && (
    <section aria-labelledby="enums">
      <h2 id="enums">Enums</h2>
      {sections.enums.map((section) => (
        <section
          class="schema-section"
          id={section.id}
          aria-labelledby={`${section.id}-title`}
        >
          <h3 id={`${section.id}-title`}>
            <a href={`#${section.id}`}>
              <code>{section.name}</code>
            </a>
          </h3>
          {section.addedIn && <AddedIn version={section.addedIn} compact />}
          {section.description && (
            <p set:html={parseInlineMarkdown(section.description)} />
          )}
          <EnumValues
            values={section.values}
            descriptions={section.descriptions}
          />
        </section>
      ))}
    </section>
  )
}
{
  sections.unions.length > 0 && (
    <section aria-labelledby="unions">
      <h2 id="unions">Unions</h2>
      {sections.unions.map((section) => (
        <section
          class="schema-section"
          id={section.id}
          aria-labelledby={`${section.id}-title`}
        >
          <h3 id={`${section.id}-title`}>
            <a href={`#${section.id}`}>
              <code>{section.name}</code>
            </a>
          </h3>
          {section.addedIn && <AddedIn version={section.addedIn} compact />}
          {section.description && (
            <p set:html={parseInlineMarkdown(section.description)} />
          )}
          <UnionVariantBadges variants={section.variants} />
        </section>
      ))}
    </section>
  )
}
{
  sections.objects.length > 0 && (
    <section aria-labelledby="objects">
      <h2 id="objects">Objects</h2>
      {sections.objects.map((section) => (
        <section
          class="schema-section"
          id={section.id}
          aria-labelledby={`${section.id}-title`}
        >
          <h3 id={`${section.id}-title`}>
            <a href={`#${section.id}`}>
              <code>{section.name}</code>
            </a>
          </h3>
          {section.addedIn && <AddedIn version={section.addedIn} compact />}
          {section.description && (
            <p set:html={parseInlineMarkdown(section.description)} />
          )}
          <PropertyTable rows={section.rows} />
        </section>
      ))}
    </section>
  )
}
