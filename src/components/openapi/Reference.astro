---
import { Code } from "astro:components";
import AddedIn from "../AddedIn.astro";
import EnumValues from "./EnumValues.astro";
import PropertyTable from "./PropertyTable.astro";
import TypeBadgeGroup from "./TypeBadgeGroup.astro";
import UnionVariantBadges from "./UnionVariantBadges.astro";
import { buildReferenceIndex } from "../../lib/openapi/referenceIndex";
import { getAddedIn } from "../../lib/openapi/schema";
import type { OpenApiDocument } from "../../lib/openapi/types";
import { parseInlineMarkdown } from "../../lib/markdown";

type Props = {
  apiSpec: OpenApiDocument;
  schemaName?: string;
  header?: string;
};

const {
  apiSpec,
  schemaName = "CreateResponseBody",
  header,
} = Astro.props as Props;
const schema = apiSpec.components?.schemas?.[schemaName];
if (!schema) throw new Error(`Missing reference schema: ${schemaName}`);
const { parameterRows } = buildReferenceIndex(apiSpec, schema);
const addedIn = getAddedIn(apiSpec, schema);
const example = JSON.stringify(
  { model: "your-model", input: "Say hello" },
  null,
  2,
);
---

{
  header && (
    <h3 class="parameter-heading">
      {header} {addedIn && <AddedIn version={addedIn} compact />}
    </h3>
  )
}
<div class="parameter-columns" aria-hidden="true">
  <span>Parameter</span><span>Type</span><span>Description</span>
</div>
<div class="parameter-list">
  {
    parameterRows.map((row) => (
      <div class="parameter-row">
        <div class="parameter-meta">
          <div class="parameter-name">
            <>
              <code>{row.name}</code>
              <span
                class:list={[
                  "parameter-presence",
                  { "is-required": row.required },
                ]}
              >
                {row.required ? "required" : "optional"}
              </span>
            </>
            {row.addedIn && <AddedIn version={row.addedIn} compact />}
          </div>
          <TypeBadgeGroup row={row} />
        </div>
        <div class="parameter-description">
          {row.description && (
            <div set:html={parseInlineMarkdown(row.description)} />
          )}
          {schemaName === "CreateResponseBody" && row.name === "input" && (
            <div class="reference-example">
              <div class="example-toolbar">
                <span>Example</span>
                <button
                  type="button"
                  data-copy-example
                  aria-label="Copy request example"
                >
                  Copy
                </button>
                <span class="sr-only" role="status" />
              </div>
              <Code code={example} lang="json" theme="github-light" />
            </div>
          )}
          {row.isUnion &&
            row.unionVariants.some(
              (variant) => variant.sectionId || variant.groupVariants?.length,
            ) && (
              <details class="field-details">
                <summary>
                  {row.name === "input" ? "Input types" : "Accepted types"}
                </summary>
                <UnionVariantBadges variants={row.unionVariants} />
              </details>
            )}
          {!row.literalValue && !row.isUnion && row.enumValues.length > 0 && (
            <details class="field-details">
              <summary>Allowed values</summary>
              <EnumValues
                values={row.enumValues}
                descriptions={row.enumDescriptions}
              />
            </details>
          )}
          {row.inlineable && row.inlineRows.length > 0 && (
            <details class="field-details">
              <summary>Fields</summary>
              <PropertyTable rows={row.inlineRows} />
            </details>
          )}
        </div>
      </div>
    ))
  }
</div>
