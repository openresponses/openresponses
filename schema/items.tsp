using TypeSpec.OpenAPI;
using OpenResponsesSchema;
namespace OpenResponses;

@summary("Item reference")
@doc("An internal identifier for an item to reference.")
model ItemReferenceParam {
  type?: DefaultLiteral<
    "item_reference",
    "The type of item to reference. Always `item_reference`."
  > | null;

  @doc("The ID of the item to reference.")
  id: string;
}

model ReasoningItemParam {
  id?: ExampleString<"The unique ID of this reasoning item.", "rs_123"> | null;

  @doc("The item type. Always `reasoning`.")
  type: "reasoning" = "reasoning";

  @doc("Reasoning summary content associated with this item.")
  summary: ReasoningSummaryContentParam[];

  content?: null;
  encrypted_content?: DescribedString<"An encrypted representation of the reasoning content."> | null;
}

@summary("Compaction item")
@doc("A compaction item generated by the [`v1/responses/compact` API](/docs/api-reference/responses/compact).")
@extension("x-openresponses-added-in", "2026-04-24")
model CompactionSummaryItemParam {
  id?: ExampleString<"The ID of the compaction item.", "cmp_123"> | null;

  @doc("The type of the item. Always `compaction`.")
  type: "compaction" = "compaction";

  @doc("The encrypted content of the compaction summary.")
  @maxLength(10485760)
  encrypted_content: string;
}

model UserMessageItemParam {
  id?: ExampleString<"The unique ID of this message item.", "msg_123"> | null;

  @doc("The item type. Always `message`.")
  type: "message" = "message";

  @doc("The message role. Always `user`.")
  role: "user" = "user";

  @doc("The message content, as an array of content parts.")
  @oneOf
  @oneOfItems(
    "type",
    "A piece of message content, such as text, an image, or a file."
  )
  content: (InputTextContentParam | InputImageContentParamAutoParam | InputFileContentParam)[] | BoundedString<
    10485760,
    "The message content, as a single string."
  >;

  status?: DescribedString<"The status of the message item."> | null;
}

model SystemMessageItemParam {
  id?: ExampleString<"The unique ID of this message item.", "msg_123"> | null;

  @doc("The item type. Always `message`.")
  type: "message" = "message";

  @doc("The message role. Always `system`.")
  role: "system" = "system";

  @doc("The message content, as an array of content parts.")
  @oneOf
  @oneOfItems("type", "")
  content: InputTextContentParam[] | BoundedString<
    10485760,
    "The message content, as a single string."
  >;

  status?: DescribedString<"The status of the message item."> | null;
}

model DeveloperMessageItemParam {
  id?: ExampleString<"The unique ID of this message item.", "msg_123"> | null;

  @doc("The item type. Always `message`.")
  type: "message" = "message";

  @doc("The message role. Always `developer`.")
  role: "developer" = "developer";

  @doc("The message content, as an array of content parts.")
  @oneOf
  @oneOfItems("type", "")
  content: InputTextContentParam[] | BoundedString<
    10485760,
    "The message content, as a single string."
  >;

  status?: DescribedString<"The status of the message item."> | null;
}

model AssistantMessageItemParam {
  id?: ExampleString<"The unique ID of this message item.", "msg_123"> | null;

  @doc("The item type. Always `message`.")
  type: "message" = "message";

  @doc("The role of the message author. Always `assistant`.")
  role: "assistant" = "assistant";

  @doc("The message content, as an array of content parts.")
  @oneOf
  @oneOfItems(
    "type",
    "A piece of assistant message content, such as text or a refusal."
  )
  content: (OutputTextContentParam | RefusalContentParam)[] | BoundedString<
    10485760,
    "The message content, as a single string."
  >;

  @doc("Labels an `assistant` message as intermediate commentary (`commentary`) or the final answer (`final_answer`). For models like `gpt-5.3-codex` and beyond, when sending follow-up requests, preserve and resend phase on all assistant messages. Omitting it can degrade performance. Not used for user messages.")
  @extension("x-openresponses-added-in", "2026-04-24")
  phase?: "commentary" | "final_answer";

  status?: DescribedString<"The status of the message item."> | null;
}

enum FunctionCallItemStatus {
  in_progress,
  completed,
  incomplete,
}

model FunctionCallItemParam {
  id?: ExampleString<
    "The unique ID of this function tool call.",
    "fc_123"
  > | null;

  @doc("The unique ID of the function tool call generated by the model.")
  @minLength(1)
  @maxLength(64)
  call_id: string;

  @doc("The item type. Always `function_call`.")
  type: "function_call" = "function_call";

  @doc("The name of the function to call.")
  @minLength(1)
  @maxLength(64)
  @pattern("^[a-zA-Z0-9_-]+$")
  name: string;

  @doc("The function arguments as a JSON string.")
  arguments: string;

  @refDoc("The status of the function tool call.")
  status?: FunctionCallStatus | null;
}

@summary("Function tool call output")
@doc("The output of a function tool call.")
model FunctionCallOutputItemParam {
  id?: ExampleString<
    "The unique ID of the function tool call output. Populated when this item is returned via API.",
    "fc_123"
  > | null;

  @doc("The unique ID of the function tool call generated by the model.")
  @minLength(1)
  @maxLength(64)
  call_id: string;

  @doc("The type of the function tool call output. Always `function_call_output`.")
  type: "function_call_output" = "function_call_output";

  @doc("Text, image, or file output of the function tool call.")
  @oneOf
  @arrayDoc("An array of content outputs (text, image, file) for the function tool call.")
  @oneOfItems(
    "type",
    "A piece of message content, such as text, an image, or a file."
  )
  output: BoundedString<
    10485760,
    "A JSON string of the output of the function tool call."
  > | (
    | InputTextContentParam
    | InputImageContentParamAutoParam
    | InputFileContentParam
    | InputVideoContent)[];

  @refDoc("The status of the item. One of `in_progress`, `completed`, or `incomplete`. Populated when items are returned via API.")
  status?: FunctionCallStatus | null;
}

@extension("discriminator", #{ propertyName: "type" })
@extension("x-unionDisplay", "section")
@extension("x-unionTitle", "Input Item Types")
@oneOf
@extension("discriminator", #{ propertyName: "type" })
union ItemParam {
  ItemReferenceParam,
  ReasoningItemParam,
  CompactionSummaryItemParam,
  UserMessageItemParam,
  SystemMessageItemParam,
  DeveloperMessageItemParam,
  AssistantMessageItemParam,
  FunctionCallItemParam,
  FunctionCallOutputItemParam,
}

@extension(
  "x-enumDescriptions",
  #{
    assistant: "Model-generated content in the conversation.",
    developer: "Developer-supplied guidance that shapes the assistant’s behavior.",
    system: "System-level instructions that set global behavior.",
    user: "End‑user input in the conversation.",
  }
)
enum MessageRole {
  user,
  assistant,
  system,
  developer,
}

@extension(
  "x-enumDescriptions",
  #{
    completed: "Model has finished sampling this item.",
    in_progress: "Model is currently sampling this item.",
    incomplete: "Model was interrupted from sampling this item partway through. This can occur, for example, if the model encounters a stop token or exhausts its output_token budget.",
  }
)
enum MessageStatus {
  in_progress,
  completed,
  incomplete,
}

@summary("Message")
@doc("A message to or from the model.")
model Message {
  @doc("The type of the message. Always set to `message`.")
  type: "message" = "message";

  @doc("The unique ID of the message.")
  id: string;

  @refDoc("The status of item. One of `in_progress`, `completed`, or `incomplete`. Populated when items are returned via API.")
  status: MessageStatus;

  @refDoc("The role of the message. One of `unknown`, `user`, `assistant`, `system`, `critic`, `discriminator`, `developer`, or `tool`.")
  role: MessageRole;

  @doc("The content of the message")
  @oneOfItems("type", "A content part that makes up an input or output item.")
  content: (
    | InputTextContent
    | OutputTextContent
    | TextContent
    | SummaryTextContent
    | ReasoningTextContent
    | RefusalContent
    | InputImageContent
    | InputFileContent
    | InputVideoContent)[];

  @doc("Labels an `assistant` message as intermediate commentary (`commentary`) or the final answer (`final_answer`). For models like `gpt-5.3-codex` and beyond, when sending follow-up requests, preserve and resend phase on all assistant messages. Omitting it can degrade performance. Not used for user messages.")
  @extension("x-openresponses-added-in", "2026-04-24")
  phase?: "commentary" | "final_answer";
}

@extension(
  "x-enumDescriptions",
  #{
    completed: "Model has finished sampling this item.",
    in_progress: "Model is currently sampling this item.",
    incomplete: "Model was interrupted from sampling this item partway through. This can occur, for example, if the model encounters a stop token or exhausts its output_token budget.",
  }
)
enum FunctionCallStatus {
  in_progress,
  completed,
  incomplete,
}

@summary("Function call")
@doc("A function tool call that was generated by the model.")
model FunctionCall {
  @doc("The type of the item. Always `function_call`.")
  type: "function_call" = "function_call";

  @doc("The unique ID of the function call item.")
  id: string;

  @doc("The unique ID of the function tool call that was generated.")
  call_id: string;

  @doc("The name of the function that was called.")
  name: string;

  @doc("The arguments JSON string that was generated.")
  arguments: string;

  @refDoc("The status of the function call item that was recorded.")
  status: FunctionCallStatus;
}

@doc("Similar to `FunctionCallStatus`. All three options are allowed here for compatibility, but because in practice these items will be provided by developers, only `completed` should be used.")
enum FunctionCallOutputStatusEnum {
  in_progress,
  completed,
  incomplete,
}

@summary("Function call output")
@doc("A function tool call output that was returned by the tool.")
model FunctionCallOutput {
  @doc("The type of the function tool call output. Always `function_call_output`.")
  type: "function_call_output" = "function_call_output";

  @doc("The unique ID of the function tool call output. Populated when this item is returned via API.")
  id: string;

  @doc("The unique ID of the function tool call generated by the model.")
  call_id: string;

  @oneOf
  @arrayDoc("An array of output contents (images, files, text) for the function tool call.")
  @oneOfItems("type", "A content part that makes up an input or output item.")
  output: DescribedString<"A JSON string of the output of the function tool call."> | (InputTextContent | InputImageContent | InputFileContent)[];

  @refDoc("The status of the item. One of `in_progress`, `completed`, or `incomplete`. Populated when items are returned via API.")
  status: FunctionCallOutputStatusEnum;
}

@summary("Reasoning item")
@doc("A reasoning item that was generated by the model.")
model ReasoningBody {
  @doc("The type of the item. Always `reasoning`.")
  type: "reasoning" = "reasoning";

  @doc("The unique ID of the reasoning item.")
  id: string;

  @doc("The reasoning content that was generated.")
  @oneOfItems("type", "A content part that makes up an input or output item.")
  content?: (
    | InputTextContent
    | OutputTextContent
    | TextContent
    | SummaryTextContent
    | ReasoningTextContent
    | RefusalContent
    | InputImageContent
    | InputFileContent)[];

  @doc("The reasoning summary content that was generated.")
  @oneOfItems("type", "A content part that makes up an input or output item.")
  summary: (
    | InputTextContent
    | OutputTextContent
    | TextContent
    | SummaryTextContent
    | ReasoningTextContent
    | RefusalContent
    | InputImageContent
    | InputFileContent)[];

  @doc("The encrypted reasoning content that was generated.")
  encrypted_content?: string;
}

@summary("Compaction item")
@doc("A compaction item generated by the [`v1/responses/compact` API](/docs/api-reference/responses/compact).")
@extension("x-openresponses-added-in", "2026-04-24")
model CompactionBody {
  @doc("The type of the item. Always `compaction`.")
  type: "compaction" = "compaction";

  @doc("The unique ID of the compaction item.")
  id: string;

  @doc("The encrypted content that was produced by compaction.")
  encrypted_content: string;

  @doc("The identifier of the actor that created the item.")
  created_by?: string;
}

@doc("An item representing a message, tool call, tool output, reasoning, or other response element.")
@extension("discriminator", #{ propertyName: "type" })
@oneOf
@extension("discriminator", #{ propertyName: "type" })
union ItemField {
  Message,
  FunctionCall,
  FunctionCallOutput,
  ReasoningBody,
  CompactionBody,
}
