using TypeSpec.OpenAPI;
using OpenResponsesSchema;
namespace OpenResponses;

/** An internal identifier for an item to reference. */
@summary("Item reference")
model ItemReferenceParam {
  /** The type of item to reference. Always `item_reference`. */
  type?: DefaultLiteral<"item_reference"> | null;

  /** The ID of the item to reference. */
  id: string;
}

model ReasoningItemParam {
  /** The unique ID of this reasoning item. */
  @extension("example", "rs_123")
  id?: string | null;

  /** The item type. Always `reasoning`. */
  type: "reasoning" = "reasoning";

  /** Reasoning summary content associated with this item. */
  summary: ReasoningSummaryContentParam[];

  content?: null;

  /** An encrypted representation of the reasoning content. */
  encrypted_content?: string | null;
}

/**
 * A compaction item generated by the [`v1/responses/compact`
 * API](/docs/api-reference/responses/compact).
 */
@summary("Compaction item")
@extension("x-openresponses-added-in", "2026-04-24")
model CompactionSummaryItemParam {
  /** The ID of the compaction item. */
  @extension("example", "cmp_123")
  id?: string | null;

  /** The type of the item. Always `compaction`. */
  type: "compaction" = "compaction";

  /** The encrypted content of the compaction summary. */
  @maxLength(10485760)
  encrypted_content: string;
}

model UserMessageItemParam {
  /** The unique ID of this message item. */
  @extension("example", "msg_123")
  id?: string | null;

  /** The item type. Always `message`. */
  type: "message" = "message";

  /** The message role. Always `user`. */
  role: "user" = "user";

  /** The message content, as a string or an array of content parts. */
  @oneOf
  @oneOfItems(
    "type",
    "A piece of message content, such as text, an image, or a file."
  )
  content: (InputTextContentParam | InputImageContentParamAutoParam | InputFileContentParam)[] | BoundedString<10485760>;

  /** The status of the message item. */
  status?: string | null;
}

model SystemMessageItemParam {
  /** The unique ID of this message item. */
  @extension("example", "msg_123")
  id?: string | null;

  /** The item type. Always `message`. */
  type: "message" = "message";

  /** The message role. Always `system`. */
  role: "system" = "system";

  /** The message content, as a string or an array of content parts. */
  @oneOf
  @oneOfItems("type", "")
  content: InputTextContentParam[] | BoundedString<10485760>;

  /** The status of the message item. */
  status?: string | null;
}

model DeveloperMessageItemParam {
  /** The unique ID of this message item. */
  @extension("example", "msg_123")
  id?: string | null;

  /** The item type. Always `message`. */
  type: "message" = "message";

  /** The message role. Always `developer`. */
  role: "developer" = "developer";

  /** The message content, as a string or an array of content parts. */
  @oneOf
  @oneOfItems("type", "")
  content: InputTextContentParam[] | BoundedString<10485760>;

  /** The status of the message item. */
  status?: string | null;
}

model AssistantMessageItemParam {
  /** The unique ID of this message item. */
  @extension("example", "msg_123")
  id?: string | null;

  /** The item type. Always `message`. */
  type: "message" = "message";

  /** The role of the message author. Always `assistant`. */
  role: "assistant" = "assistant";

  /** The message content, as a string or an array of content parts. */
  @oneOf
  @oneOfItems(
    "type",
    "A piece of assistant message content, such as text or a refusal."
  )
  content: (OutputTextContentParam | RefusalContentParam)[] | BoundedString<10485760>;

  /**
   * Labels an `assistant` message as intermediate commentary (`commentary`) or the
   * final answer (`final_answer`). For models like `gpt-5.3-codex` and beyond, when
   * sending follow-up requests, preserve and resend phase on all assistant messages.
   * Omitting it can degrade performance. Not used for user messages.
   */
  @extension("x-openresponses-added-in", "2026-04-24")
  phase?: "commentary" | "final_answer";

  /** The status of the message item. */
  status?: string | null;
}

enum FunctionCallItemStatus {
  in_progress,
  completed,
  incomplete,
}

model FunctionCallItemParam {
  /** The unique ID of this function tool call. */
  @extension("example", "fc_123")
  id?: string | null;

  /** The unique ID of the function tool call generated by the model. */
  @minLength(1)
  @maxLength(64)
  call_id: string;

  /** The item type. Always `function_call`. */
  type: "function_call" = "function_call";

  /** The name of the function to call. */
  @minLength(1)
  @maxLength(64)
  @pattern("^[a-zA-Z0-9_-]+$")
  name: string;

  /** The function arguments as a JSON string. */
  arguments: string;

  /** The status of the function tool call. */
  status?: FunctionCallStatus | null;
}

/** The output of a function tool call. */
@summary("Function tool call output")
model FunctionCallOutputItemParam {
  /**
   * The unique ID of the function tool call output. Populated when this item is
   * returned via API.
   */
  @extension("example", "fc_123")
  id?: string | null;

  /** The unique ID of the function tool call generated by the model. */
  @minLength(1)
  @maxLength(64)
  call_id: string;

  /** The type of the function tool call output. Always `function_call_output`. */
  type: "function_call_output" = "function_call_output";

  /**
   * The function tool call output, as a JSON string or an array of text, image,
   * or file content.
   */
  @oneOf
  @arrayDoc("An array of content outputs (text, image, file) for the function tool call.")
  @oneOfItems(
    "type",
    "A piece of message content, such as text, an image, or a file."
  )
  output: BoundedString<10485760> | (
    | InputTextContentParam
    | InputImageContentParamAutoParam
    | InputFileContentParam
    | InputVideoContent)[];

  /**
   * The status of the item. One of `in_progress`, `completed`, or `incomplete`.
   * Populated when items are returned via API.
   */
  status?: FunctionCallStatus | null;
}

@extension("discriminator", #{ propertyName: "type" })
@extension("x-unionDisplay", "section")
@extension("x-unionTitle", "Input Item Types")
@oneOf
@extension("discriminator", #{ propertyName: "type" })
union ItemParam {
  ItemReferenceParam,
  ReasoningItemParam,
  CompactionSummaryItemParam,
  UserMessageItemParam,
  SystemMessageItemParam,
  DeveloperMessageItemParam,
  AssistantMessageItemParam,
  FunctionCallItemParam,
  FunctionCallOutputItemParam,
}

@extension(
  "x-enumDescriptions",
  #{
    assistant: "Model-generated content in the conversation.",
    developer: "Developer-supplied guidance that shapes the assistant’s behavior.",
    system: "System-level instructions that set global behavior.",
    user: "End‑user input in the conversation.",
  }
)
enum MessageRole {
  user,
  assistant,
  system,
  developer,
}

@extension(
  "x-enumDescriptions",
  #{
    completed: "Model has finished sampling this item.",
    in_progress: "Model is currently sampling this item.",
    incomplete: "Model was interrupted from sampling this item partway through. This can occur, for example, if the model encounters a stop token or exhausts its output_token budget.",
  }
)
enum MessageStatus {
  in_progress,
  completed,
  incomplete,
}

/** A message to or from the model. */
@summary("Message")
model Message {
  /** The type of the message. Always set to `message`. */
  type: "message" = "message";

  /** The unique ID of the message. */
  id: string;

  /**
   * The status of item. One of `in_progress`, `completed`, or `incomplete`. Populated
   * when items are returned via API.
   */
  status: MessageStatus;

  /**
   * The role of the message. One of `unknown`, `user`, `assistant`, `system`, `critic`,
   * `discriminator`, `developer`, or `tool`.
   */
  role: MessageRole;

  /** The content of the message */
  @oneOfItems("type", "A content part that makes up an input or output item.")
  content: (
    | InputTextContent
    | OutputTextContent
    | TextContent
    | SummaryTextContent
    | ReasoningTextContent
    | RefusalContent
    | InputImageContent
    | InputFileContent
    | InputVideoContent)[];

  /**
   * Labels an `assistant` message as intermediate commentary (`commentary`) or the
   * final answer (`final_answer`). For models like `gpt-5.3-codex` and beyond, when
   * sending follow-up requests, preserve and resend phase on all assistant messages.
   * Omitting it can degrade performance. Not used for user messages.
   */
  @extension("x-openresponses-added-in", "2026-04-24")
  phase?: "commentary" | "final_answer";
}

@extension(
  "x-enumDescriptions",
  #{
    completed: "Model has finished sampling this item.",
    in_progress: "Model is currently sampling this item.",
    incomplete: "Model was interrupted from sampling this item partway through. This can occur, for example, if the model encounters a stop token or exhausts its output_token budget.",
  }
)
enum FunctionCallStatus {
  in_progress,
  completed,
  incomplete,
}

/** A function tool call that was generated by the model. */
@summary("Function call")
model FunctionCall {
  /** The type of the item. Always `function_call`. */
  type: "function_call" = "function_call";

  /** The unique ID of the function call item. */
  id: string;

  /** The unique ID of the function tool call that was generated. */
  call_id: string;

  /** The name of the function that was called. */
  name: string;

  /** The arguments JSON string that was generated. */
  arguments: string;

  /** The status of the function call item that was recorded. */
  status: FunctionCallStatus;
}

/**
 * Similar to `FunctionCallStatus`. All three options are allowed here for
 * compatibility, but because in practice these items will be provided by developers,
 * only `completed` should be used.
 */
enum FunctionCallOutputStatusEnum {
  in_progress,
  completed,
  incomplete,
}

/** A function tool call output that was returned by the tool. */
@summary("Function call output")
model FunctionCallOutput {
  /** The type of the function tool call output. Always `function_call_output`. */
  type: "function_call_output" = "function_call_output";

  /**
   * The unique ID of the function tool call output. Populated when this item is
   * returned via API.
   */
  id: string;

  /** The unique ID of the function tool call generated by the model. */
  call_id: string;

  /**
   * The function tool call output, as a JSON string or an array of text, image,
   * or file content.
   */
  @oneOf
  @arrayDoc("An array of output contents (images, files, text) for the function tool call.")
  @oneOfItems("type", "A content part that makes up an input or output item.")
  output: string | (InputTextContent | InputImageContent | InputFileContent)[];

  /**
   * The status of the item. One of `in_progress`, `completed`, or `incomplete`.
   * Populated when items are returned via API.
   */
  status: FunctionCallOutputStatusEnum;
}

/** A reasoning item that was generated by the model. */
@summary("Reasoning item")
model ReasoningBody {
  /** The type of the item. Always `reasoning`. */
  type: "reasoning" = "reasoning";

  /** The unique ID of the reasoning item. */
  id: string;

  /** The reasoning content that was generated. */
  @oneOfItems("type", "A content part that makes up an input or output item.")
  content?: (
    | InputTextContent
    | OutputTextContent
    | TextContent
    | SummaryTextContent
    | ReasoningTextContent
    | RefusalContent
    | InputImageContent
    | InputFileContent)[];

  /** The reasoning summary content that was generated. */
  @oneOfItems("type", "A content part that makes up an input or output item.")
  summary: (
    | InputTextContent
    | OutputTextContent
    | TextContent
    | SummaryTextContent
    | ReasoningTextContent
    | RefusalContent
    | InputImageContent
    | InputFileContent)[];

  /** The encrypted reasoning content that was generated. */
  encrypted_content?: string;
}

/**
 * A compaction item generated by the [`v1/responses/compact`
 * API](/docs/api-reference/responses/compact).
 */
@summary("Compaction item")
@extension("x-openresponses-added-in", "2026-04-24")
model CompactionBody {
  /** The type of the item. Always `compaction`. */
  type: "compaction" = "compaction";

  /** The unique ID of the compaction item. */
  id: string;

  /** The encrypted content that was produced by compaction. */
  encrypted_content: string;

  /** The identifier of the actor that created the item. */
  created_by?: string;
}

/**
 * An item representing a message, tool call, tool output, reasoning, or other response
 * element.
 */
@extension("discriminator", #{ propertyName: "type" })
@oneOf
@extension("discriminator", #{ propertyName: "type" })
union ItemField {
  Message,
  FunctionCall,
  FunctionCallOutput,
  ReasoningBody,
  CompactionBody,
}
